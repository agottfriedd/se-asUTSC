DATABASE_URL=postgresql://senias:senias_dev_2026@localhost:5432/senias_utscmx
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Firebase Admin SDK — Firebase Console → ⚙️ Configuración del proyecto →
# Cuentas de servicio → Generar nueva clave privada (descarga un JSON).
# Copia estos 3 campos del JSON (project_id, client_email, private_key).
# La private key va en UNA sola línea, entre comillas, con los saltos como \n.
FIREBASE_PROJECT_ID=seniasutsc
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seniasutsc.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# URL de Realtime Database (necesaria para leer/escribir el rol de usuarios)
FIREBASE_DATABASE_URL=https://seniasutsc-default-rtdb.firebaseio.com
